{
  "name": "vinui-monorepo",
  "private": true,
  "description": "VinUI: free, open-source components in 8 styles for HTML, React, Vue and Svelte.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devvinish/vin-ui.git"
  },
  "homepage": "https://vinish.dev/ui",
  "type": "module",
  "workspaces": [
    "packages/styles",
    "packages/theme",
    "packages/html",
    "packages/react",
    "packages/svelte",
    "packages/cli",
    "apps/docs"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @vinui/styles && npm run build -w @vinui/docs",
    "dev": "npm run build -w @vinui/styles && npm run dev -w @vinui/docs",
    "preview": "npm run preview -w @vinui/docs",
    "test": "npm run build -w @vinui/styles && npm test --workspaces --if-present",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1"
  }
}
