{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": { "@/components/vin/*": ["./src/*"] }
  },
  "include": ["src/**/*", "examples/**/*", "test/**/*", "vitest.config.ts"]
}
