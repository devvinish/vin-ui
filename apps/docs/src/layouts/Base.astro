---
import "@vinui/styles/vinui.css";
import "../styles/site.css";
import { STYLES, DEFAULT_STYLE } from "@vinui/styles";
import { DEFAULT_THEME, themeToAttributes } from "@vinui/theme";
import Header from "../components/Header.astro";
import Customize from "../components/Customize.astro";
import Search from "../components/Search.astro";
import { href, fontsHref } from "../lib/site";

export interface Props { title: string; seoTitle?: string; description?: string; current?: string; hasSidebar?: boolean; jsonLd?: object }
const { title, seoTitle, description = "VinUI is a free, open-source UI component library for HTML, React, Vue and Svelte: accessible components, blocks and charts in 8 styles, any accent colour, light and dark.", current, hasSidebar = false, jsonLd } = Astro.props;
const fullTitle = seoTitle ?? (title === "VinUI" ? "VinUI: Free UI Component Library for HTML, React, Vue & Svelte" : `${title} · VinUI`);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const { vars } = themeToAttributes(DEFAULT_THEME);
const rootStyle = Object.entries(vars).map(([k, v]) => `${k}:${v}`).join(";");
// Ads load only in the live build (npm run build:live). Local builds and tests never load them.
const ads = import.meta.env.PUBLIC_MEDIAVINE === "1";
---
<!doctype html>
<html lang="en" data-vin-style={DEFAULT_STYLE} style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VinUI" />
    <meta name="twitter:card" content="summary" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref([...STYLES.map((s) => s.fonts), ["Space+Grotesk:wght@500;600;700", "Geist:wght@400;500;600", "JetBrains+Mono:wght@400;500"]])} />
    {ads && <script is:inline type="text/javascript" async="async" data-noptimize="1" data-cfasync="false" src="//scripts.mediavine.com/tags/53e609c8-2504-4519-ac11-c70bca527159.js"></script>}
    <!-- Apply the saved theme before first paint, so there is no flash of the default style. -->
    <script is:inline>
      (function () {
        try {
          var d = document.documentElement, b = JSON.parse(localStorage.getItem("vinui:boot") || "null");
          if (!b) return;
          for (var k in b.attrs) b.attrs[k] === null ? d.removeAttribute(k) : d.setAttribute(k, b.attrs[k]);
          d.style.removeProperty("--vin-font");
          for (var v in b.vars) d.style.setProperty(v, b.vars[v]);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header current={current} hasSidebar={hasSidebar} />
    <slot />
    <Customize />
    <Search />
    <div class="toast" hidden role="status" aria-live="polite" data-toast></div>
    <script>
      import "../scripts/theme-ui.ts";
      import "@vinui/html/vinui.js";
    </script>
  </body>
</html>
