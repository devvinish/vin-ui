---
import Base from "./Base.astro";
import Sidebar from "../components/Sidebar.astro";
import RightRail from "../components/RightRail.astro";

export interface Props { title: string; seoTitle?: string; description?: string; current?: string; toc?: { id: string; text: string }[] }
const { title, seoTitle, description, current, toc = [] } = Astro.props;
const GUIDES = ["installation", "theming", "frameworks", "cli", "ai"];
---
<Base title={title} seoTitle={seoTitle} description={description} current={current === "styles" ? "styles" : GUIDES.includes(current ?? "") || current === "docs" ? "docs" : "components"} hasSidebar>
  <div class="docs">
    <Sidebar current={current} />
    <main class="main" id="main">
      <slot />
    </main>
    <RightRail toc={toc} />
  </div>
</Base>
