---
import Base from "./Base.astro";
import Sidebar from "../components/Sidebar.astro";
import RightRail from "../components/RightRail.astro";

export interface Props { title: string; description?: string; current?: string; toc?: { id: string; text: string }[] }
const { title, description, current, toc = [] } = Astro.props;
---
<Base title={title} description={description} current={current === "styles" ? "styles" : "components"} hasSidebar>
  <div class="docs">
    <Sidebar current={current} />
    <main class="main" id="main">
      <slot />
    </main>
    <RightRail toc={toc} />
  </div>
</Base>
