---
/** Full-width pages without the docs sidebar: Blocks, Charts, Create. */
import Base from "./Base.astro";
export interface Props { title: string; description: string; current: string }
const { title, description, current } = Astro.props;
---
<Base title={title} description={description} current={current}>
  <main id="main" class="gallery-page">
    <div class="container">
      <slot />
    </div>
  </main>
</Base>
