---
/**
 * Right-sidebar ad unit (Mediavine siderail), same markup as the vinish.dev game pages.
 * An empty 300 × 600 region: Mediavine fills it. Settings in src/config/ads.ts.
 */
import { ads } from "../config/ads";
---
{ads.enabled && (
  <aside class="ad-slot mv-siderail-slot" aria-label="Advertisement"><div id={ads.slotId}></div></aside>
)}
