---
/**
 * Right-sidebar ad unit (Mediavine siderail), same markup pattern as the vinish.dev game pages.
 * Settings live in src/config/ads.ts.
 */
import { ads } from "../config/ads";
const showPlaceholder = import.meta.env.DEV && ads.placeholderInDev;
---
{ads.enabled && (
  <aside class="ad-slot mv-siderail-slot" aria-label="Advertisement">
    <div id={ads.slotId}>
      {showPlaceholder && <div class="ad-placeholder" aria-hidden="true"><span>Mediavine siderail<br />300 × 600 (dev preview)</span></div>}
    </div>
  </aside>
)}
