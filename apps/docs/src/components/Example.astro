---
/**
 * One example: live preview + code, with HTML / React / Vue / Svelte tabs.
 * The HTML preview is the snippet itself; the React preview is the real React
 * component rendered on the server (slot "react"), so both stay honest.
 * Vue and Svelte show their source under the HTML preview: their tests check they render
 * the same markup, and repeating the preview would repeat its ids on the page.
 */
import { Code } from "astro:components";
import Icon from "./Icon.astro";

const { id, html, react, vue, svelte } = Astro.props as { id: string; html: string; react: string; vue?: string; svelte?: string };
const themes = { light: "github-light", dark: "github-dark" } as const;
const tabs = [
  { fw: "html", label: "HTML" },
  { fw: "react", label: "React" },
  ...(vue ? [{ fw: "vue", label: "Vue" }] : []),
  ...(svelte ? [{ fw: "svelte", label: "Svelte" }] : []),
];
const extra = [
  ...(vue ? [{ fw: "vue", label: "Vue", ext: "vue", lang: "vue", code: vue }] : []),
  ...(svelte ? [{ fw: "svelte", label: "Svelte", ext: "svelte", lang: "svelte", code: svelte }] : []),
];
---
<div class="example" data-tabs id={`ex-${id}`}>
  <div class="example-bar">
    <div class="seg" role="tablist" aria-label="Framework">
      {tabs.map((t, i) => (
        <button type="button" role="tab" aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1} aria-controls={`${id}-${t.fw}`} id={`${id}-tab-${t.fw}`} data-tab={t.fw}>{t.label}</button>
      ))}
    </div>
    <span class="now" data-style-now></span>
  </div>
  <div role="tabpanel" id={`${id}-html`} aria-labelledby={`${id}-tab-html`} data-panel="html">
    <div class="preview vin-stage"><div set:html={html} /></div>
    <div class="code">
      <div class="code-head"><span>{id}.html</span><button class="copy-btn" type="button" data-copy><Icon name="copy" size={13} />Copy</button></div>
      <Code code={html.trim()} lang="html" themes={themes} defaultColor={false} />
    </div>
  </div>
  <div role="tabpanel" id={`${id}-react`} aria-labelledby={`${id}-tab-react`} data-panel="react" hidden>
    <div class="preview vin-stage"><div><slot name="react" /></div></div>
    <div class="code">
      <div class="code-head"><span>{id}.tsx</span><button class="copy-btn" type="button" data-copy><Icon name="copy" size={13} />Copy</button></div>
      <Code code={react.trim()} lang="tsx" themes={themes} defaultColor={false} />
    </div>
  </div>
  {extra.map((x) => (
    <div role="tabpanel" id={`${id}-${x.fw}`} aria-labelledby={`${id}-tab-${x.fw}`} data-panel={x.fw} hidden>
      <p class="example-note">The {x.label} version renders the same markup as the HTML tab, so it looks and works the same.</p>
      <div class="code">
        <div class="code-head"><span>{id}.{x.ext}</span><button class="copy-btn" type="button" data-copy><Icon name="copy" size={13} />Copy</button></div>
        <Code code={x.code.trim()} lang={x.lang} themes={themes} defaultColor={false} />
      </div>
    </div>
  ))}
</div>
