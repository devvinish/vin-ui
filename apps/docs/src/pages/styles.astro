---
import Docs from "../layouts/Docs.astro";
import { STYLES } from "@vinui/styles";
import { href } from "../lib/site";
const toc = STYLES.map((s) => ({ id: s.id, text: s.name }));
---
<Docs title="Styles" description="The 8 VinUI styles: Precision, Tactile, Clay, Tonal, Editorial, Terminal, Paper and Bento." current="styles" toc={toc}>
  <div class="crumbs"><a href={href("/")}>VinUI</a><span>Styles</span></div>
  <h1 class="page-title">Styles</h1>
  <p class="page-lead">Every component ships in all 8. Each card below keeps its own style so you can compare them; "Use this style" switches the whole site.</p>
  <div class="style-cards">
    {STYLES.map((s) => (
      <article class="style-card" id={s.id} data-current-style={s.id}>
        <div class="vin-stage" data-vin-style={s.id}>
          <button type="button" class="vin-btn">Primary</button>
          <button type="button" class="vin-btn vin-btn--secondary">Secondary</button>
          <button type="button" class="vin-btn vin-btn--outline">Outline</button>
        </div>
        <div class="meta">
          <h3>{s.name}</h3>
          <p>{s.description}</p>
          <div class="tags">{s.tags.map((t: string) => <span>{t}</span>)}</div>
          <button type="button" class="btn" data-set-style={s.id} aria-checked="false">Use this style</button>
        </div>
      </article>
    ))}
  </div>
</Docs>
