---
/**
 * Visual-test fixture: every Button example with no site chrome.
 * Usage: /ui/fixtures/button/?style=clay&mode=dark
 * The Playwright suite screenshots this page in all 8 styles × light/dark and runs axe on it.
 */
import "@vinui/styles/vinui.css";
import { STYLES, DEFAULT_STYLE } from "@vinui/styles";
import { DEFAULT_THEME, themeToAttributes } from "@vinui/theme";
import { fontsHref } from "../../lib/site";
import variantsHtml from "../../../../../packages/html/src/button/variants.html?raw";
import sizesHtml from "../../../../../packages/html/src/button/sizes.html?raw";
import statesHtml from "../../../../../packages/html/src/button/states.html?raw";
import { ButtonVariants } from "../../../../../packages/react/examples/button/variants";
import { ButtonSizes } from "../../../../../packages/react/examples/button/sizes";
import { ButtonStates } from "../../../../../packages/react/examples/button/states";

const { vars } = themeToAttributes(DEFAULT_THEME);
const rootStyle = Object.entries(vars).map(([k, v]) => `${k}:${v}`).join(";");
---
<!doctype html>
<html lang="en" data-vin-style={DEFAULT_STYLE} data-vin-mode="light" style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Button fixture · VinUI</title>
    <link rel="stylesheet" href={fontsHref(STYLES.map((s) => s.fonts))} />
    <script is:inline>
      (function () {
        var p = new URLSearchParams(location.search), d = document.documentElement;
        if (p.get("style")) d.setAttribute("data-vin-style", p.get("style"));
        if (p.get("mode")) d.setAttribute("data-vin-mode", p.get("mode"));
      })();
    </script>
    <style>
      body { margin: 0; font-family: var(--vin-font); color: var(--vin-fg); background: var(--vin-surface); }
      main { display: grid; gap: 1px; }
      section { padding: 24px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
      h2 { width: 100%; margin: 0 0 4px; font: 500 12px ui-monospace, monospace; color: var(--vin-muted); }
      .row { display: contents; }
    </style>
  </head>
  <body>
    <main id="fixture">
      <section class="vin-stage" data-fixture="html-variants"><h2>HTML · variants</h2><div class="row" set:html={variantsHtml} /></section>
      <section class="vin-stage" data-fixture="html-sizes"><h2>HTML · sizes</h2><div class="row" set:html={sizesHtml} /></section>
      <section class="vin-stage" data-fixture="html-states"><h2>HTML · states</h2><div class="row" set:html={statesHtml} /></section>
      <section class="vin-stage" data-fixture="react-variants"><h2>React · variants</h2><ButtonVariants /></section>
      <section class="vin-stage" data-fixture="react-sizes"><h2>React · sizes</h2><ButtonSizes /></section>
      <section class="vin-stage" data-fixture="react-states"><h2>React · states</h2><ButtonStates /></section>
    </main>
  </body>
</html>
