---
import Docs from "../../layouts/Docs.astro";
import Example from "../../components/Example.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ReactExample from "../../components/ReactExample";
import { href, SITE } from "../../lib/site";
import { SPECS, getExamples, getImports, needsScript, type Spec } from "../../data/registry";

export function getStaticPaths() {
  return SPECS.map((spec) => ({ params: { slug: spec.name }, props: { spec } }));
}
const { spec } = Astro.props as { spec: Spec };
const examples = getExamples(spec.name);
const imports = getImports(spec.name);
const script = needsScript(spec.name);
const toc = [
  ...examples.map((e) => ({ id: e.id, text: e.title })),
  { id: "install", text: "Installation" },
  { id: "api", text: "API" },
  { id: "accessibility", text: "Accessibility" },
];
const props = Object.entries(spec.props);
const reactImport = `import { ${[...spec.react.components, ...(spec.react.helpers ?? [])].join(", ")} } from "@/components/vin/${spec.name}";`;
---
<Docs title={spec.title} seoTitle={`${spec.title} Component for HTML, React, Vue & Svelte · VinUI`} description={`Free, accessible ${spec.title} component for HTML, React, Vue and Svelte. ${spec.description} In 8 styles, light and dark. Copy the code or add it with the CLI.`} current={spec.name} toc={toc}>
  <div class="crumbs"><a href={href("/")}>VinUI</a><a href={href("/components/")}><span>Components</span></a><span>{spec.title}</span></div>
  <h1 class="page-title">{spec.title}</h1>
  <p class="page-lead">{spec.description} Same markup and props in every style: switch the style in the header to see it change.</p>
  <div class="meta-links">
    <a href={href(`/fixtures/${spec.name}/`)}>Test fixture</a>
    <a href={`${SITE.github}/blob/main/spec/${spec.name}.json`} rel="noopener">spec/{spec.name}.json</a>
  </div>

  <div class="prose">
    {examples.map((ex) => (
      <>
        <h2 id={ex.id}>{ex.title}</h2>
        <p>{ex.description}</p>
        <Example id={`${spec.name}-${ex.id}`} html={ex.html} react={ex.react} vue={ex.vue} svelte={ex.svelte}><ReactExample slot="react" client:load name={spec.name} id={ex.id} /></Example>
      </>
    ))}

    <h2 id="install">Installation</h2>
    <p>React, Vue and Svelte: add the component to your project with the CLI. It reads your framework from <code>vin.json</code> and also copies any component this one needs. Then import it:</p>
    <CodeBlock title="Terminal" lang="bash" code={`npx @vinish/ui add ${spec.name}`} />
    <CodeBlock title="React" lang="tsx" code={reactImport} />
    {imports.vue && <CodeBlock title="Vue" lang="ts" code={imports.vue} />}
    {imports.svelte && <CodeBlock title="Svelte" lang="ts" code={imports.svelte} />}
    <p>The import paths assume the default folders: <code>@/components/vin</code> (React and Vue, with the usual <code>@</code> → <code>src</code> alias) and <code>$lib/components/vin</code> (SvelteKit). Use your own if you chose another folder in <code>init</code>. How the Vue and Svelte versions pass values and content is in <a href={href("/docs/frameworks/")}>Frameworks</a>.</p>
    <p>Plain HTML: the classes come with the style's stylesheet. {script
      ? <>This component also needs <a href={href("/docs/installation/#html")}><code>vinui.js</code></a> for its keyboard and pointer behaviour.</>
      : <>It needs no JavaScript.</>}</p>

    <h2 id="api">API</h2>
    <p>From <code>spec/{spec.name}.json</code>, which every framework version is tested against.</p>
    {props.length > 0 && (
      <div class="table-wrap">
        <table class="api">
          <thead><tr><th>Prop</th><th>Values</th><th>Default</th><th>In HTML</th></tr></thead>
          <tbody>
            {props.map(([name, p]) => (
              <tr>
                <td><code>{name}</code>{p.description && <div class="muted" style="font-size:12.5px;margin-top:4px">{p.description}</div>}</td>
                <td>{p.values ? p.values.map((v) => <code style="margin-right:4px">{v}</code>) : <code>{p.type ?? "boolean"}</code>}</td>
                <td>{p.default !== undefined ? <code>{String(p.default)}</code> : "—"}</td>
                <td>{p.class ? <code>{p.class}</code> : p.html ? <code>{p.html}</code> : "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    <h3>Parts</h3>
    <div class="table-wrap">
      <table class="api">
        <thead><tr><th>React, Vue, Svelte</th><th>HTML classes</th></tr></thead>
        <tbody>
          <tr>
            <td>{spec.react.components.map((c) => <code style="margin:0 4px 4px 0;display:inline-block">{`<${c}>`}</code>)}</td>
            <td>{spec.classes.map((c) => <code style="margin:0 4px 4px 0;display:inline-block">.{c}</code>)}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 id="accessibility">Accessibility</h2>
    <ul class="checklist">{spec.a11y.map((item) => <li>{item}</li>)}</ul>
  </div>
</Docs>
