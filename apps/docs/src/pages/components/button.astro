---
import Docs from "../../layouts/Docs.astro";
import Example from "../../components/Example.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { href } from "../../lib/site";
import spec from "../../../../../spec/button.json";

import variantsHtml from "../../../../../packages/html/src/button/variants.html?raw";
import sizesHtml from "../../../../../packages/html/src/button/sizes.html?raw";
import statesHtml from "../../../../../packages/html/src/button/states.html?raw";
import variantsTsx from "../../../../../packages/react/examples/button/variants.tsx?raw";
import sizesTsx from "../../../../../packages/react/examples/button/sizes.tsx?raw";
import statesTsx from "../../../../../packages/react/examples/button/states.tsx?raw";
import { ButtonVariants } from "../../../../../packages/react/examples/button/variants";
import { ButtonSizes } from "../../../../../packages/react/examples/button/sizes";
import { ButtonStates } from "../../../../../packages/react/examples/button/states";

const toc = [
  { id: "variants", text: "Variants" },
  { id: "sizes", text: "Sizes" },
  { id: "states", text: "Icons, disabled, links" },
  { id: "install", text: "Installation" },
  { id: "api", text: "API" },
  { id: "accessibility", text: "Accessibility" },
];
const props = Object.entries(spec.props as Record<string, any>);
---
<Docs title="Button" description="VinUI Button: 5 variants and 4 sizes, in 8 styles, for HTML and React." current="button" toc={toc}>
  <div class="crumbs"><a href={href("/")}>VinUI</a><a href={href("/components/")}><span>Components</span></a><span>Button</span></div>
  <h1 class="page-title">Button</h1>
  <p class="page-lead">Triggers an action. Same markup and props in every style: switch the style in the header to see it change.</p>
  <div class="meta-links">
    <a href={href("/fixtures/button/")}>Test fixture</a>
    <a href="https://github.com/devvinish/vin-ui/blob/main/spec/button.json" rel="noopener">spec/button.json</a>
  </div>

  <div class="prose">
    <h2 id="variants">Variants</h2>
    <p>Use <code>primary</code> for the main action on a screen, and the quieter variants for everything else.</p>
    <Example id="variants" html={variantsHtml} react={variantsTsx}><ButtonVariants slot="react" /></Example>

    <h2 id="sizes">Sizes</h2>
    <p>Sizes come from the style's scale, and Customize → Density adjusts all of them together. Icon buttons need an <code>aria-label</code>.</p>
    <Example id="sizes" html={sizesHtml} react={sizesTsx}><ButtonSizes slot="react" /></Example>

    <h2 id="states">Icons, disabled, links</h2>
    <p>Pass <code>href</code> and the React Button renders a link. A disabled link gets <code>aria-disabled</code> and leaves the tab order.</p>
    <Example id="states" html={statesHtml} react={statesTsx}><ButtonStates slot="react" /></Example>

    <h2 id="install">Installation</h2>
    <p>HTML: add the stylesheet once and put <code>data-vin-style</code> on <code>&lt;html&gt;</code>. React: add the component file to your project with the CLI.</p>
    <CodeBlock title="Terminal" lang="bash" code={`npx @vinish/ui add button`} />
    <CodeBlock title="index.html" lang="html" code={`<!-- vinui.css is added to your project by: npx @vinish/ui init -->\n<html data-vin-style="precision">\n  <link rel="stylesheet" href="/vinui.css">`} />

    <h2 id="api">API</h2>
    <p>From <code>spec/button.json</code>, which every framework version is tested against.</p>
    <div class="table-wrap">
      <table class="api">
        <thead><tr><th>Prop</th><th>Values</th><th>Default</th><th>HTML class</th></tr></thead>
        <tbody>
          {props.map(([name, p]) => (
            <tr>
              <td><code>{name}</code></td>
              <td>{p.values ? p.values.map((v: string) => <code style="margin-right:4px">{v}</code>) : <code>{p.type ?? "boolean"}</code>}</td>
              <td>{p.default !== undefined ? <code>{String(p.default)}</code> : "—"}</td>
              <td>{p.class ? <code>{p.class}</code> : p.html ? <code>{p.html}</code> : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="accessibility">Accessibility</h2>
    <ul class="checklist">
      {(spec.a11y as string[]).map((item) => <li>{item}</li>)}
    </ul>
  </div>
</Docs>
